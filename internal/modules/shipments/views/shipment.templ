package views

import (
	"go-starter/internal/modules/shipments/views/components"
	"go-starter/internal/modules/shipments/views/layouts"
)

templ ShipmentPage() {
	@layouts.BaseLayout("Shipment Management", ShipmentScripts()) {
		<!-- Header -->
		@components.Header()
		<!-- Main Content -->
		<main class="mx-auto px-4 py-8 w-full max-w-7xl xl:max-w-[98vw] 2xl:max-w-[98vw]">
			@components.AddShipmentForm()
			<!-- Main Content Area -->
			<div class="grid grid-cols-1 gap-8">
				@components.ShipmentsGrid()
				@components.ShipmentsMap()
			</div>
		</main>
		<!-- Modal -->
		@components.ShipmentModal()
	}
}

templ ShipmentScripts() {
	<!-- AG-Grid JS -->
	<script src="/assets/js/ag-grid-enterprise.min.js"></script>
	<!-- Leaflet JS -->
	<script src="/assets/js/leaflet.js"></script>
	<!-- Main Application Script -->
	<script type="module" src="/scripts/main.js"></script>
}
