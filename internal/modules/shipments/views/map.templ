package views

import (
	"go-starter/internal/modules/shipments/views/components"
	"go-starter/internal/modules/shipments/views/layouts"
)

templ MapPage() {
	@layouts.BaseLayout("Shipment Map - Real-time Tracking", MapScripts()) {
		@components.Header()
		<main class="mx-auto px-4 py-6 w-full max-w-7xl xl:max-w-[98vw] 2xl:max-w-[98vw]">
			<div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
				<div class="relative">
					<!-- Map Container -->
					<div id="standaloneMap" class="map-container rounded-md"></div>
					<!-- Map Status -->
					<div class="map-status">
						<div id="mapStatusContent">
							<span class="connection-indicator disconnected"></span>
							<span>Loading...</span>
						</div>
					</div>
				</div>
			</div>
		</main>
		<!-- Modal -->
		@components.ShipmentModal()
	}
}

templ MapScripts() {
	<script src="/assets/js/leaflet.js"></script>
	<script type="module" src="/scripts/map/init-standalone-map.js"></script>
}
