package views

import "go-starter/internal/modules/shipments/views/components"
import "go-starter/internal/modules/shipments/dto"
import "go-starter/internal/modules/shipments/views/layouts"

templ PublicShipmentsGrid(view dto.PublicViewReadResponse) {
	@layouts.PublicBaseLayout("Shipment Status", PublicViewScripts()) {
		@components.PublicHeader(view.Name)
		<main class="mx-auto max-w-[1920px] p-2 sm:p-4 lg:p-6 h-screen">
			<div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
				<div class="flex flex-col gap-0 divider-y dark:divide-gray-700">
					<div class="p-2 sm:p-4 lg:p-6 w-full">
						<div
							id="public-grid"
							data-view-id={ view.ID.String() }
							class="ag-theme-alpine w-full"
						></div>
					</div>
					<div class="mt-4 border-t border-gray-100 dark:border-gray-700"></div>
					<div class="p-2 sm:p-4 lg:p-6 w-full bg-gray-50 dark:bg-gray-800/50">
						@components.PublicShipmentsMap()
					</div>
				</div>
			</div>
			@components.ShipmentModal()
		</main>
	}
}

templ PublicViewScripts() {
	<script src="/assets/js/ag-grid-enterprise.min.js"></script>
	<script src="/assets/js/leaflet.js"></script>
	<script type="module" src="/scripts/public-view.js"></script>
}
