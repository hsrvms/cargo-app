package components

templ PublicShipmentsMap() {
	<div class="w-full flex flex-col h-full">
		<div class="flex items-center justify-between mb-2">
			<h2 class="text-lg font-semibold text-gray-900 dark:text-white">Vessel Map</h2>
		</div>
		<div id="miniMap" class="w-full h-[300px] lg:h-[500px] rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden"></div>
	</div>
}
